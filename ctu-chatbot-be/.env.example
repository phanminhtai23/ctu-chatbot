DATABASE_URL=postgresql://ctu:ctu_dev_password@localhost:5433/ctu_chatbot
# LLM (Gemini): điền 1-9 key; hết hạn mức (429) sẽ tự xoay sang key kế tiếp.
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
DEEPSEEK_API_KEY=
ENV=dev
SECRET_KEY=dev-only-change-me-dev-only-change-me-0000
GOOGLE_CLIENT_ID=
# Mặc định chỉ nhận email CTU. Đặt [] để cho mọi email đăng nhập (chỉ khi test).
# Email quản trị viên (cách nhau bằng dấu phẩy): đăng nhập bằng email này là có quyền admin, kể cả khi không thuộc tên miền được phép.
# ADMIN_EMAILS=you@gmail.com,other@ctu.edu.vn
# ALLOWED_EMAIL_DOMAINS=["ctu.edu.vn","edu.ctu.vn"]

# RAG (ChromaDB nhúng + embedding Gemini). Key embedding rỗng thì dùng GEMINI_API_KEY_1.
EMBEDDING_MODEL=models/gemini-embedding-2
EMBEDDING_MODEL_API_KEY=
EMBEDDING_DIM=768

# Giới hạn chat cho mỗi user, MỘT biến: "<số tin>/<thời gian>" (s = giây, m = phút, h = giờ), "off" = không giới hạn.
# Ví dụ: 10/5m (mặc định), 30/1h, 5/30s
CHAT_RATE_LIMIT=10/5m

