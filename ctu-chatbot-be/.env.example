DATABASE_URL=postgresql://ctu:ctu_dev_password@localhost:5433/ctu_chatbot
# LLM (Gemini): điền 1-9 key; hết hạn mức (429) sẽ tự xoay sang key kế tiếp.
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
DEEPSEEK_API_KEY=
ENV=dev
SECRET_KEY=dev-only-change-me-dev-only-change-me-0000
GOOGLE_CLIENT_ID=
# Mặc định chỉ nhận email CTU. Đặt [] để cho mọi email đăng nhập (chỉ khi test).
# Email quản trị viên (cách nhau bằng dấu phẩy): đăng nhập bằng email này là có quyền admin, kể cả khi không thuộc tên miền được phép.
# ADMIN_EMAILS=you@gmail.com,other@ctu.edu.vn
# ALLOWED_EMAIL_DOMAINS=["ctu.edu.vn","edu.ctu.vn"]

# RAG (ChromaDB nhúng + embedding Gemini). Key embedding rỗng thì dùng GEMINI_API_KEY_1.
EMBEDDING_MODEL=models/gemini-embedding-2
EMBEDDING_MODEL_API_KEY=
EMBEDDING_DIM=768

# Giới hạn chat cho mỗi user, MỘT biến: "<số tin>/<thời gian>" (s = giây, m = phút, h = giờ, d = ngày), "off" = không giới hạn.
# Nhiều cửa sổ cách nhau bằng dấu phẩy, tin chỉ được nhận khi mọi cửa sổ còn chỗ. Ví dụ: 10/5m (mặc định), 30/1h, 10/5m,40/1d
CHAT_RATE_LIMIT=10/5m


# Lưu file người dùng (ảnh đại diện, PDF/ảnh tải lên) trên Cloudinary. Lấy ở Cloudinary Console -> Dashboard -> API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ctu-chatbot
# Dung lượng tối đa mỗi người dùng (ảnh đại diện + tệp tải lên) và mỗi lần tải, tính bằng MB.
USER_STORAGE_QUOTA_MB=20
USER_UPLOAD_MAX_MB=5

# Kiến thức bổ sung do admin nhập (hỏi - đáp): ngưỡng độ giống (cosine) để đưa vào câu trả lời / để trả lời thẳng theo mục đó.
# KB_MIN_SCORE=0.72
# KB_STRONG_SCORE=0.8
